# Copy this file to .env (same folder as server.js) and fill in your key.
# Get a free key at https://www.alphavantage.co/support/#api-key — no credit card required.
# Leave unset / delete this file to run in mock-data mode (Refresh Data will
# regenerate the deterministic mock engine instead of calling Alpha Vantage).
ALPHAVANTAGE_API_KEY=

# Optional, but recommended before relying on "Pull Fundamentals" regularly.
# Powers the SEC EDGAR fundamentals pull (real revenue/EBITDA/debt/cash/shares
# outstanding for the Valuation tab) — free, no key, no daily cap. SEC asks
# every API consumer to identify themselves with a descriptive User-Agent +
# real contact: https://www.sec.gov/os/webmaster-faq#developers
# Format: "YourAppOrName your-email@example.com" — put your own, not a
# placeholder, and keep this in .env (gitignored), never hardcoded in source.
SEC_EDGAR_CONTACT=
